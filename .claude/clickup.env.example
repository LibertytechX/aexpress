# ClickUp Credentials for AI Task Logging
# Copy this file to clickup.env and fill in real values.
# clickup.env is gitignored — never commit it.

# Get from ClickUp -> Profile -> Settings -> Apps -> "Generate" under API Token
CLICKUP_API_TOKEN=pk_xxxxxxxx

# From any ClickUp URL: https://app.clickup.com/{TEAM_ID}/...
CLICKUP_TEAM_ID=

# From the ClickUp profile URL: https://app.clickup.com/{TEAM_ID}/settings/profile/{USER_ID}
# Or fetched automatically via GET /user if left blank
CLICKUP_USER_ID=

# Right-click Getlinked space -> Copy link -> ID in URL
CLICKUP_SPACE_ID=

# List IDs per view (right-click each list -> Copy link -> ID in URL)
CLICKUP_LIST_RECRUITER_VIEW=
CLICKUP_LIST_TALENT_VIEW=
CLICKUP_LIST_JOBS=
CLICKUP_LIST_INTERVIEW=
CLICKUP_LIST_ASSESSMENT=
CLICKUP_LIST_CV_REVIEW=
